# Neon serverless Postgres connection string
# Copy this file to .env.local and replace with your Neon DATABASE_URL
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Optional but recommended in production (Vercel).
# Pin the current read.lsbible.org Next.js build ID to skip automatic
# homepage lookup and avoid HTTP 429 rate limits from serverless IPs.
# Find it in the page source of https://read.lsbible.org/ as "buildId":"...".
# LSB_BUILD_ID=your_build_id_here
