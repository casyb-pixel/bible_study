# Neon serverless Postgres connection string
# Copy this file to .env.local and replace with your Neon DATABASE_URL
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# API.Bible access key (required for chapter reading)
# Create/manage keys at https://scripture.api.bible/
API_BIBLE_KEY=

# Optional overrides if your account uses different bible IDs
# API_BIBLE_ID_NKJV=63097d2a0a2f7db3-01
# API_BIBLE_ID_NIV=78a9f6124f344018-01
# API_BIBLE_ID_NLT=d6e14a625393b4da-01

# xAI API key for Scripture clarification (server-side only)
# Create/manage keys at https://console.x.ai/
XAI_API_KEY=

# Optional model override (default: grok-3-mini)
# XAI_MODEL=grok-3-mini
