# Neon serverless Postgres connection string
# Copy this file to .env.local and replace with your Neon DATABASE_URL
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Optional: pin a read.lsbible.org Next.js build ID if auto-detection fails on Vercel
# LSB_BUILD_ID=
